[Unit]
Description=Galaxy Buds native seamless switching
After=pipewire-pulse.service bluetooth.target

[Service]
Type=simple
# Replace /path/to/galaxy-buds-seamless-linux and AA:BB:CC:DD:EE:FF with your actual directory and Buds MAC address
ExecStart=/usr/bin/python3 /path/to/galaxy-buds-seamless-linux/buds_switch.py seamless AA:BB:CC:DD:EE:FF
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
